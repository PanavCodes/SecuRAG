# ---- LLM (API model for router / grader / generator / reflection) ----
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_MAIN=
LLM_MODEL_FAST=

# ---- Pinecone ----
PINECONE_API_KEY=
PINECONE_INDEX=securag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- Neo4j (password must be 8+ characters) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- Models ----
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=cuda            # cuda or cpu
EMBED_BATCH_SIZE=32    # lower to 8-16 if you hit out-of-memory on an 8 GB GPU

# ---- Data slice ----
DATA_YEARS=2024,2025
CVE_MAX=20000

# ---- Agent limits ----
MAX_REWRITE_ROUNDS=3
RECURSION_LIMIT=50
RETRIEVAL_TOP_K=20
RERANK_TOP_N=6
NOVELTY_COSINE_THRESHOLD=0.90

# ---- Tracing ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=securag

# ---- Web fallback (optional) ----
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
